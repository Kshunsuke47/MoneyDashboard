<Window x:Class="MoneyDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Money Dashboard"
        Width="1100"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="55" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <TextBlock Text="Money Dashboard"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="24,0" />
        </Border>

        <!-- ナビゲーション -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="24,0"
                    VerticalAlignment="Center">

            <Button Content="Dashboard"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="DashboardButton_Click" />

            <Button Content="収入"
                    Width="90"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="IncomeButton_Click" />

            <Button Content="支出"
                    Width="90"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="ExpenseButton_Click" />

            <Button Content="サブスク"
                    Width="90"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="SubscriptionButton_Click" />

            <Button Content="資産"
                    Width="90"
                    Height="36"
                    Click="AssetButton_Click" />

        </StackPanel>

        <!-- 選択した画面を表示 -->
        <ContentControl x:Name="MainContent"
                        Grid.Row="2" />

    </Grid>

</Window>