<UserControl x:Class="MoneyDashboard.App.Views.IncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MoneyDashboard.App.Converters"
             xmlns:behaviors="clr-namespace:MoneyDashboard.App.Behaviors">

    <UserControl.Resources>
        <converters:DateOnlyDatePickerConverter
            x:Key="DateOnlyDatePickerConverter" />

        <BooleanToVisibilityConverter
             x:Key="BooleanToVisibilityConverter" />
        
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <!-- タイトル -->
            <TextBlock Text="収入管理"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- 対象年月 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <Button Content="＜"
                        Width="40"
                        Height="32"
                        IsEnabled="{Binding IsRegisterMode}"
                        Command="{Binding PreviousMonthCommand}" />

                <TextBlock Text="{Binding TargetMonth,
                                 StringFormat={}{0:yyyy年M月}}"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0" />

                <Button Content="＞"
                        Width="40"
                        Height="32"
                        IsEnabled="{Binding IsRegisterMode}"
                        Command="{Binding NextMonthCommand}" />

            </StackPanel>

            <!-- 登録エリア -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="{Binding FormTitle}"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,0,0,16" />

                    <TextBlock Text="収入日" />

                    <DatePicker SelectedDate="{Binding IncomeDate,
                                 Converter={StaticResource DateOnlyDatePickerConverter}}"
                                Width="180"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,12" />

                    <TextBlock Text="収入内容" />

                    <TextBox Text="{Binding Description}"
                             MaxLength="50"
                             Margin="0,4,0,12" />

                    <TextBlock Text="カテゴリ" />

                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="CategoryName"
                              SelectedValuePath="CategoryId"
                              SelectedValue="{Binding SelectedCategoryId}"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,4,0,12" />

                    <TextBlock Text="金額" />

                    <TextBox Text="{Binding Amount}"
                              behaviors:NumericTextBoxBehavior.IsEnabled="True"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,4,0,12" />

                    <TextBlock Text="備考" />

                    <TextBox Text="{Binding Note}"
                             MaxLength="200"
                             Height="70"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,4,0,16" />

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <!-- 登録モード -->
                        <Button Content="クリア"
                            Width="90"
                            Height="36"
                            Margin="0,0,8,0"
                            Command="{Binding ClearCommand}"
                            Visibility="{Binding IsRegisterMode,
                                        Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Content="登録"
                            Width="90"
                            Height="36"
                            Command="{Binding RegisterCommand}"
                            Visibility="{Binding IsRegisterMode,
                                        Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- 編集モード -->
                        <Button Content="キャンセル"
                            Width="90"
                            Height="36"
                            Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}"
                            Visibility="{Binding IsEditMode,
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Content="更新"
                            Width="90"
                            Height="36"
                            Command="{Binding UpdateCommand}"
                            Visibility="{Binding IsEditMode,
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- 合計 -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="収入合計："
                               FontSize="18"
                               FontWeight="Bold" />

                    <TextBlock Text="{Binding IncomeTotal,
                                     StringFormat={}{0:N0} 円}"
                               FontSize="18"
                               FontWeight="Bold" />

                </StackPanel>

            </Border>

            <!-- 一覧 -->
            <TextBlock Text="収入一覧"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <DataGrid ItemsSource="{Binding Incomes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MinHeight="250">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="収入日"
                                        Width="110"
                                        Binding="{Binding IncomeDate,
                                                  StringFormat={}{0:yyyy/MM/dd}}" />

                    <DataGridTextColumn Header="収入内容"
                                        Width="*"
                                        Binding="{Binding Description}" />

                    <DataGridTextColumn Header="カテゴリ"
                                        Width="130"
                                        Binding="{Binding CategoryName}" />

                    <DataGridTextColumn Header="金額"
                                        Width="130"
                                        Binding="{Binding Amount,
                                                  StringFormat={}{0:N0} 円}" />

                    <DataGridTextColumn Header="備考"
                                        Width="200"
                                        Binding="{Binding Note}" />

                    <DataGridTemplateColumn Header="操作"
                                            Width="150">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="編集"
                                            Width="60"
                                            Margin="0,0,5,0"
                                            IsEnabled="{Binding DataContext.IsRegisterMode,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Command="{Binding DataContext.BeginEditCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IncomeId}" />

                                    <Button Content="削除"
                                            Width="60"
                                            IsEnabled="{Binding DataContext.IsRegisterMode,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Command="{Binding DataContext.DeleteCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IncomeId}" />

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </ScrollViewer>

</UserControl>