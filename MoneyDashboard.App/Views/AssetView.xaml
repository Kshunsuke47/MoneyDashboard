<UserControl x:Class="MoneyDashboard.App.Views.AssetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:MoneyDashboard.App.Behaviors">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <!-- タイトル -->
            <TextBlock Text="資産管理"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- 対象年月 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <Button Content="＜"
                        Width="40"
                        Height="32"
                        IsEnabled="{Binding IsAccountRegisterMode}"
                        Command="{Binding PreviousMonthCommand}" />

                <TextBlock Text="{Binding TargetMonth,
                                 StringFormat={}{0:yyyy年M月}}"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0" />

                <Button Content="＞"
                        Width="40"
                        Height="32"
                        IsEnabled="{Binding IsAccountRegisterMode}"
                        Command="{Binding NextMonthCommand}" />

            </StackPanel>

            <!-- 口座登録・編集 -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="{Binding AccountFormTitle}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,16" />

                    <TextBlock Text="口座名" />

                    <TextBox Text="{Binding AccountName}"
                             MaxLength="50"
                             Width="300"
                             HorizontalAlignment="Left"
                             Margin="0,4,0,16" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <!-- 登録モード -->
                        <Button Content="クリア"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Command="{Binding ClearAccountCommand}"
                                Visibility="{Binding IsAccountRegisterMode,
                                    Converter={StaticResource BoolToVisibility}}" />

                        <Button Content="登録"
                                Width="90"
                                Height="36"
                                Command="{Binding RegisterAccountCommand}"
                                Visibility="{Binding IsAccountRegisterMode,
                                    Converter={StaticResource BoolToVisibility}}" />

                        <!-- 編集モード -->
                        <Button Content="キャンセル"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Command="{Binding CancelAccountEditCommand}"
                                Visibility="{Binding IsAccountEditMode,
                                    Converter={StaticResource BoolToVisibility}}" />

                        <Button Content="更新"
                                Width="90"
                                Height="36"
                                Command="{Binding UpdateAccountCommand}"
                                Visibility="{Binding IsAccountEditMode,
                                    Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- 銀行口座・月初残高 -->
            <TextBlock Text="預金口座"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <DataGrid ItemsSource="{Binding BankBalances}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      IsEnabled="{Binding IsAccountRegisterMode}"
                      MinHeight="180"
                      Margin="0,0,0,20">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="口座名"
                                        Width="*"
                                        IsReadOnly="True"
                                        Binding="{Binding AccountName}" />

                    <DataGridTextColumn Header="状態"
                                        Width="100"
                                        IsReadOnly="True"
                                        Binding="{Binding StatusText}" />

                    <!-- ここだけ入力可能 -->
                    <DataGridTemplateColumn Header="月初預金残高"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBox Text="{Binding OpeningBalance,
                                         UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsEnabled="True"
                                         Margin="4" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="残高保存"
                                            Width="100">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button Content="保存"
                                        Width="70"
                                        Command="{Binding DataContext.SaveBalanceCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="口座操作"
                                            Width="170">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="編集"
                                            Width="60"
                                            Margin="0,0,5,0"
                                            Command="{Binding DataContext.BeginAccountEditCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding AccountId}" />

                                    <Button Content="利用終了"
                                            Width="80"
                                            IsEnabled="{Binding IsActive}"
                                            Command="{Binding DataContext.DeactivateAccountCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding AccountId}" />

                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

            <!-- 預金合計 -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="月初預金残高合計："
                               FontSize="18"
                               FontWeight="Bold" />

                    <TextBlock Text="{Binding OpeningBankBalance,
                                     StringFormat={}{0:N0} 円,
                                     TargetNullValue=未算出}"
                               FontSize="18"
                               FontWeight="Bold" />

                </StackPanel>

            </Border>

            <!-- NISA -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="NISA"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,16" />

                    <TextBlock Text="評価額" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">

                        <TextBox Text="{Binding NisaEvaluationAmount,
                                       UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericTextBoxBehavior.IsEnabled="True"
                                 Width="220"
                                 Height="30"
                                 IsEnabled="{Binding IsAccountRegisterMode}" />

                        <Button Content="保存"
                                Width="90"
                                Height="30"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding IsAccountRegisterMode}"
                                Command="{Binding SaveNisaCommand}" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- 資産総額 -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="資産総額"
                               FontSize="16" />

                    <TextBlock Text="{Binding TotalAssets,
                                     StringFormat={}{0:N0} 円,
                                     TargetNullValue=未算出}"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,0" />

                    <TextBlock Text="預金 ＋ NISA評価額"
                               Margin="0,4,0,0" />

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>