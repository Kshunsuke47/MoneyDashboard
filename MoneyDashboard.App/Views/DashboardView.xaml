<UserControl x:Class="MoneyDashboard.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MoneyDashboard.App.Converters">

    <UserControl.Resources>

        <converters:SignedMoneyConverter
            x:Key="SignedMoneyConverter" />

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <!-- タイトル -->
            <TextBlock Text="Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- 対象年月 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">

                <Button Content="＜"
                        Width="40"
                        Height="32"
                        Command="{Binding PreviousMonthCommand}" />

                <TextBlock Text="{Binding TargetMonth,
                                 StringFormat={}{0:yyyy年M月}}"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0" />

                <Button Content="＞"
                        Width="40"
                        Height="32"
                        Command="{Binding NextMonthCommand}" />

            </StackPanel>

            <!-- 資産増加予定額 -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="今月の資産増加予定額"
                               FontSize="18"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding AssetIncreaseForecast,
                                     Converter={StaticResource SignedMoneyConverter}}"
                               FontSize="36"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />

                </StackPanel>

            </Border>

            <!-- 収入・支出 -->
            <Grid Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 収入 -->
                <Border Grid.Column="0"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="収入"
                                   FontSize="16" />

                        <TextBlock Text="{Binding IncomeTotal,
                                         StringFormat={}{0:N0} 円}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />

                    </StackPanel>

                </Border>

                <!-- 支出 -->
                <Border Grid.Column="2"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="支出"
                                   FontSize="16" />

                        <TextBlock Text="{Binding ExpenseTotal,
                                         StringFormat={}{0:N0} 円}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />

                    </StackPanel>

                </Border>

            </Grid>

            <!-- 月末見込預金残高 -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="月末見込預金残高"
                               FontSize="16" />

                    <TextBlock Text="{Binding ProjectedClosingBankBalance,
                                     StringFormat={}{0:N0} 円,
                                     TargetNullValue=未算出}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0" />

                </StackPanel>

            </Border>

            <!-- 資産 -->
            <TextBlock Text="資産"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <Grid Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 月初預金残高 -->
                <Border Grid.Column="0"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="月初預金残高"
                                   FontSize="15" />

                        <TextBlock Text="{Binding OpeningBankBalance,
                                         StringFormat={}{0:N0} 円,
                                         TargetNullValue=未算出}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />

                    </StackPanel>

                </Border>

                <!-- NISA -->
                <Border Grid.Column="2"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="NISA評価額"
                                   FontSize="15" />

                        <TextBlock Text="{Binding NisaEvaluationAmount,
                                         StringFormat={}{0:N0} 円,
                                         TargetNullValue=未登録}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />

                    </StackPanel>

                </Border>

                <!-- 資産総額 -->
                <Border Grid.Column="4"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="資産総額"
                                   FontSize="15" />

                        <TextBlock Text="{Binding TotalAssets,
                                         StringFormat={}{0:N0} 円,
                                         TargetNullValue=未算出}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />

                    </StackPanel>

                </Border>

            </Grid>

            <!-- サブスク -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="利用中サブスク"
                               FontSize="18"
                               FontWeight="Bold" />

                    <TextBlock Text="{Binding ActiveSubscriptionMonthlyTotal,
                                     StringFormat={}{0:N0} 円 / 月}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,8,0,4" />

                    <TextBlock Text="{Binding ActiveSubscriptionCount,
                                     StringFormat=利用中：{0}件}" />

                </StackPanel>

            </Border>

            <!-- 直近の急な出費 -->
            <TextBlock Text="直近の急な出費"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8" />

            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">

                <ListView ItemsSource="{Binding UnexpectedExpenses}"
                                          BorderThickness="0">

                    <!-- 各行をListViewいっぱいまで広げる -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                                Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Grid Margin="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <!-- 日付 -->
                                <TextBlock Grid.Column="0"
                                                   Text="{Binding ExpenseDate,
                                  StringFormat={}{0:yyyy/MM/dd}}"
                                                    VerticalAlignment="Center" />

                                <!-- 内容 -->
                                <TextBlock Grid.Column="1"
                                              Text="{Binding Description}"
                                              VerticalAlignment="Center"
                                              Margin="8,0" />

                                <!-- 金額 -->
                                <TextBlock Grid.Column="2"
                                                    Text="{Binding Amount,
                                                          StringFormat={}{0:N0} 円}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>